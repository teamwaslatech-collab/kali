{
  "name": "Kali XFCE noVNC",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "kali",
  "runArgs": ["--shm-size=1g"],
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Kali Desktop (noVNC)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postStartCommand": "chmod +x .devcontainer/start-desktop.sh && .devcontainer/start-desktop.sh"
}
